* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    /* Paleta de cores: Preto, Laranja e Cinza */
    --primary-color: #ff6b00;        /* Laranja vibrante */
    --primary-dark: #e65c00;         /* Laranja escuro */
    --primary-light: #ff8c33;        /* Laranja claro */

    --bg-dark: #0a0a0a;              /* Preto quase puro */
    --bg-card: #1a1a1a;              /* Cinza muito escuro */
    --bg-element: #2a2a2a;           /* Cinza escuro */
    --bg-highlight: #333333;         /* Cinza para destaque */

    --text-primary: #f5f5f5;         /* Branco suave */
    --text-secondary: #a0a0a0;       /* Cinza mdio */
    --text-muted: #6b6b6b;           /* Cinza escuro para texto */

    --border-color: #3a3a3a;         /* Cinza para bordas */
    --border-light: #4a4a4a;         /* Cinza claro para bordas */

    --danger-color: #ff4444;         /* Vermelho para erros */
    --success-color: #00c853;        /* Verde para sucesso */
    --info-color: #29b6f6;           /* Azul para informaes */

    --shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.5);
    --glow: 0 0 20px rgba(255, 107, 0, 0.3);
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, var(--bg-dark) 0%, #1f1f1f 50%, var(--bg-dark) 100%);
    min-height: 100vh;
    padding: 20px;
    color: var(--text-primary);
}

.container {
    max-width: 1000px;
    margin: 0 auto;
}

header {
    text-align: center;
    margin-bottom: 30px;
    padding: 30px 20px;
    background: linear-gradient(135deg, var(--bg-card), var(--bg-element));
    border-radius: 12px;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-lg);
}

header h1 {
    font-size: 2.5rem;
    margin-bottom: 10px;
    color: var(--primary-color);
    text-shadow: 0 0 10px rgba(255, 107, 0, 0.5);
    letter-spacing: 1px;
}

.subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
}

main {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.card {
    background: var(--bg-card);
    border-radius: 12px;
    padding: 25px;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border-color);
}

.card h2 {
    color: var(--primary-color);
    margin-bottom: 20px;
    font-size: 1.5rem;
    border-bottom: 3px solid var(--primary-color);
    padding-bottom: 10px;
    display: inline-block;
}

/* Formulrio */
.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-bottom: 15px;
}

.form-group {
    margin-bottom: 15px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    color: var(--text-primary);
    font-weight: 600;
}

.form-group input,
.form-group select {
    width: 100%;
    padding: 12px 15px;
    border: 2px solid var(--border-color);
    border-radius: 8px;
    font-size: 1rem;
    background: var(--bg-element);
    color: var(--text-primary);
    transition: all 0.3s ease;
}

.form-group input::placeholder {
    color: var(--text-muted);
}

.form-group input:focus,
.form-group select:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: var(--glow);
    background: #333333;
}

.form-group select {
    cursor: pointer;
}

.form-group select option {
    background: var(--bg-element);
    color: var(--text-primary);
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
    color: white;
    border: none;
    padding: 14px 30px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 10px;
}

.btn-primary:hover {
    background: linear-gradient(135deg, var(--primary-light), var(--primary-color));
    transform: translateY(-2px);
    box-shadow: var(--glow);
}

.btn-secondary {
    background: transparent;
    color: var(--text-secondary);
    border: 2px solid var(--border-color);
    padding: 12px 25px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-secondary:hover {
    border-color: var(--primary-color);
    color: var(--primary-color);
    background: var(--bg-element);
}

/* Resultados Grid */
.results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 15px;
    margin-bottom: 25px;
}

.result-item {
    background: var(--bg-element);
    border-radius: 10px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
    border: 1px solid var(--border-color);
    transition: all 0.3s ease;
}

.result-item:hover {
    border-color: var(--primary-color);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
}

.result-item.highlight {
    background: linear-gradient(135deg, var(--bg-highlight), var(--bg-element));
    border-left: 4px solid var(--primary-color);
}

.result-icon {
    font-size: 2.5rem;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    border-radius: 50%;
    border: 2px solid var(--border-color);
}

.result-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.result-label {
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.result-value {
    color: var(--text-primary);
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1;
}

.result-item.highlight .result-value {
    color: var(--primary-color);
}

.result-percent {
    color: var(--primary-light);
    font-size: 1.1rem;
    font-weight: 600;
}

.result-classification {
    color: var(--info-color);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
}

.result-detail {
    color: var(--text-muted);
    font-size: 0.8rem;
}

.action-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

/* Histrico */
.history-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 400px;
    overflow-y: auto;
}

.history-item {
    background: var(--bg-element);
    border-radius: 8px;
    padding: 15px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-left: 3px solid var(--info-color);
    transition: all 0.3s ease;
    cursor: pointer;
}

.history-item:hover {
    border-left-color: var(--primary-color);
    transform: translateX(5px);
    background: var(--bg-highlight);
}

.history-info {
    flex: 1;
}

.history-info strong {
    color: var(--text-primary);
    font-size: 1.1rem;
    display: block;
    margin-bottom: 5px;
}

.history-details {
    color: var(--text-secondary);
    font-size: 0.9rem;
    display: flex;
    gap: 15px;
}

.history-date {
    color: var(--text-muted);
    font-size: 0.85rem;
}

.history-actions {
    display: flex;
    gap: 10px;
}

.btn-icon {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    width: 35px;
    height: 35px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 1rem;
}

.btn-icon:hover {
    border-color: var(--danger-color);
    color: var(--danger-color);
    background: var(--bg-element);
}

.empty-state {
    text-align: center;
    padding: 40px 20px;
    color: var(--text-secondary);
}

.empty-state svg {
    width: 80px;
    height: 80px;
    margin-bottom: 15px;
    opacity: 0.3;
    stroke: var(--text-muted);
}

/* Log */
.log-list {
    max-height: 300px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.log-list::-webkit-scrollbar {
    width: 8px;
}

.log-list::-webkit-scrollbar-track {
    background: var(--bg-dark);
    border-radius: 4px;
}

.log-list::-webkit-scrollbar-thumb {
    background: var(--primary-color);
    border-radius: 4px;
}

.log-item {
    padding: 10px 15px;
    background: var(--bg-element);
    border-radius: 6px;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
    border-left: 3px solid var(--primary-color);
    color: var(--text-secondary);
}

.log-item.info {
    border-left-color: var(--primary-color);
}

.log-item.success {
    border-left-color: var(--success-color);
    color: var(--success-color);
}

.log-item.error {
    border-left-color: var(--danger-color);
    color: var(--danger-color);
}

.log-timestamp {
    color: var(--text-muted);
    font-size: 0.8rem;
    margin-right: 10px;
}

/* Footer */
footer {
    text-align: center;
    color: var(--text-secondary);
    margin-top: 30px;
    padding: 20px;
    background: var(--bg-card);
    border-radius: 12px;
    border: 1px solid var(--border-color);
}

/* Scrollbar personalizada */
::-webkit-scrollbar {
    width: 10px;
}

::-webkit-scrollbar-track {
    background: var(--bg-dark);
}

::-webkit-scrollbar-thumb {
    background: var(--primary-color);
    border-radius: 5px;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--primary-light);
}

/* Responsivo */
@media (max-width: 768px) {
    .form-row {
        grid-template-columns: 1fr;
    }

    .results-grid {
        grid-template-columns: 1fr;
    }

    .action-buttons {
        grid-template-columns: 1fr;
    }

    header h1 {
        font-size: 1.8rem;
    }

    .history-item {
        flex-direction: column;
        gap: 15px;
        text-align: center;
    }

    .history-details {
        justify-content: center;
    }
}

/* Efeitos de hover extras */
.card:hover {
    border-color: var(--border-light);
}

.btn-primary:active {
    transform: translateY(0);
}

.result-item:active {
    transform: scale(0.98);
}

/* Animaes */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.card {
    animation: fadeIn 0.5s ease-out;
}

.result-item {
    animation: fadeIn 0.3s ease-out;
}

.result-item:nth-child(1) { animation-delay: 0.05s; }
.result-item:nth-child(2) { animation-delay: 0.1s; }
.result-item:nth-child(3) { animation-delay: 0.15s; }
.result-item:nth-child(4) { animation-delay: 0.30s; }
